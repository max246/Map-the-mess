VITE_W3W_API_KEY=your_what3words_api_key
VITE_API_URL=http://localhost:8000

# Google sign-in — same Client ID as the backend's GOOGLE_CLIENT_ID.
# Vite inlines this into the bundle at build time, so when the frontend runs
# inside Docker it is passed as a build arg from the root .env GOOGLE_CLIENT_ID.
# Leave blank to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
