DATABASE_URL=postgresql://user:password@localhost:5432/map_the_mess
SECRET_KEY=change-me-to-a-random-string
DEBUG=true

SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me
SUPERUSER_FULL_NAME=Super User

# Stale-report scanner — number of days a report can sit untouched before being marked stale
REPORT_STALE_DAYS=30
# Shared secret required by POST /api/admin/tasks/mark-stale (X-Task-Secret header)
ADMIN_TASK_SECRET=change-me

# Google sign-in — Client ID from Google Cloud Console > Credentials.
# Used by the verifier in app/services/oauth/google.py to validate ID-token
# audiences. Leave blank to disable Google login (returns 400 from the route).
GOOGLE_CLIENT_ID=
